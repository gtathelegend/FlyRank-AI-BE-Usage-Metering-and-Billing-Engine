{
  "name": "flyrank-billing-engine",
  "version": "1.0.0",
  "description": "LLM Usage Metering & Billing Engine Capstone Project",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node ./node_modules/typescript/lib/tsc.js",
    "start": "node dist/index.js",
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "migrate": "node ./node_modules/tsx/dist/cli.mjs src/db/migrate.ts",
    "seed": "node ./node_modules/tsx/dist/cli.mjs src/db/seed.ts",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test src/tests/*.test.ts"
  },
  "keywords": [
    "metering",
    "billing",
    "stripe",
    "llm",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "FlyRank Intern",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "stripe": "^14.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}
